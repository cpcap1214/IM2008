// Authenticated-only baseline aligned with the LINE bot's role model.
// Boss: full access. Driver: read all + update orders. Customer: read own.
//
// TODO(auth): Firebase Auth + custom claims (`role`) are not wired yet.
// Deploy these rules ONLY after the dashboard's auth integration PR lands;
// otherwise unauthenticated reads from the dev seed flow will fail.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Boss & driver: read all; customer: read own
    match /Users/{userId} {
      allow read: if request.auth != null &&
                  (request.auth.token.role in ["boss", "driver"] ||
                   request.auth.uid == userId);
      allow write: if request.auth.token.role == "boss";
    }

    match /Products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == "boss";
    }

    match /Orders/{orderId} {
      allow read: if request.auth != null &&
                  (request.auth.token.role in ["boss", "driver"] ||
                   resource.data.customerId == request.auth.uid);
      allow create: if request.auth.token.role in ["boss", "customer"] &&
                    request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth.token.role in ["boss", "driver"];
      allow delete: if request.auth.token.role == "boss";
    }
  }
}

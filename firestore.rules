// Authenticated-only baseline aligned with the dashboard's two-role model
// (boss + customer). The legacy `driver` role has been removed everywhere;
// boss now reports delivery from the dashboard.
//
// TODO(auth): Firebase Auth + custom claims (`role`) are not wired yet.
// Deploy these rules ONLY after the dashboard's auth integration PR lands;
// otherwise unauthenticated reads from the dev seed flow will fail.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /Users/{userId} {
      allow read: if request.auth != null &&
                  (request.auth.token.role == "boss" ||
                   request.auth.uid == userId);
      allow write: if request.auth.token.role == "boss";
    }

    match /Products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == "boss";
    }

    match /Orders/{orderId} {
      allow read: if request.auth != null &&
                  (request.auth.token.role == "boss" ||
                   resource.data.customerId == request.auth.uid);
      allow create: if request.auth.token.role in ["boss", "customer"] &&
                    request.resource.data.customerId == request.auth.uid;
      // Only boss can flip paymentStatus / set deliveryDate / edit orders.
      allow update: if request.auth.token.role == "boss";
      allow delete: if request.auth.token.role == "boss";
    }
  }
}

# Copy this file to `.env.local` and fill in the values from your Firebase console.
# Project Settings → Your apps → Web app → Config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----- Optional: AI 智慧建議 (Gemini) -----
# 取得位置：https://aistudio.google.com/apikey
# 注意：VITE_* 變數會被打包進前端 bundle，等於公開
#       上線前請去 Google AI Studio / Cloud Console 把這把 key 鎖定 HTTP referer
#       才不會被陌生人拿去消耗你的免費額度
VITE_GEMINI_API_KEY=
# 模型選擇 (預設 gemini-2.5-flash，免費額度大、速度快)
# 其他可選: gemini-2.5-pro / gemini-1.5-flash / gemini-1.5-pro
VITE_GEMINI_MODEL=gemini-2.5-flash
